  "breaker": {
    "_comment": "断路器型号词法与分类。category_prefixes 按顺序精确匹配型号开头；category_rules 按顺序做包含/前缀判定。",
    "model_prefixes": "MCB|MCCB|RCBO|ACB|ATSE|ATS|SPD|IS\\-|DS\\-|GL\\-|HD\\-|HS\\-|NH40|GL|iC65|C65|Acti9|EA9|Easy9|NSX|NS|CVS|EZD|MTZ|MVS|Compact|NM\\d+|NXB|NB1|NXBLE|NM8|CDM\\d+|NM1|NZ7|NDQ|CDB6|CDG\\d+|CDB\\d+|CDM\\d+|NDM\\d+|NDB\\d+|NDQ\\d+|NDW\\d+|S200|S280|Tmax|XT\\d+|Emax|Formula|5SY\\d+|5SL\\d+|3VA\\d+|3VM\\d+|3WL\\d+|DZ\\d+|CM\\d+|TM\\d+|DW\\d+|CW\\d+|RMW\\d+",
    "model_regex_template": "^(?:内配\\s*)?(?:{prefixes})",
    "fallback_regex": "(?:RCBO/[1234]P|(?:MCB|MCCB|ACB|ATSE|ATS|SPD)-[A-Z0-9/]+|\\b[CDB]\\d{1,3}A?(?:/[1-4]P|\\b)|\\b\\d{1,4}A/[1-4]P|In\\s*=\\s*\\d{1,4}A)",
    "disallowed_prefixes_regex": "^(?:SC|PC|KBG|JDG|CT|FC|WC|CC|WS|BV|BVR|YJV|KVV|RVV|WDZ|ZR|NH|ZA|ZB|ZC|BBTRZ|IP\\d|GB|JGJ|CECS|ISO|IEC|MCB|MCCB|RCBO|ACB|ATSE|SPD|C65|NSX|EZD|iC65|DZ47|NM1|CM1)",
    "category_prefixes": [
      [
        "MCB",
        "微型断路器"
      ],
      [
        "RCB",
        "剩余电流动作断路器"
      ],
      [
        "MCCB",
        "塑壳断路器"
      ],
      [
        "ATSE",
        "双电源自动转换开关"
      ],
      [
        "IS-",
        "隔离开关"
      ],
      [
        "DS-",
        "隔离开关"
      ]
    ],
    "category_rules": [
      {
        "category": "剩余电流动作断路器",
        "contains_any": [
          "RCB",
          "RCBO",
          "RCD",
          "LE",
          "VIGI",
          "漏电",
          "30MA"
        ]
      },
      {
        "category": "双电源自动转换开关",
        "prefix_any": [
          "ATSE",
          "ATS",
          "NZ7",
          "NDQ",
          "WATS",
          "双电源"
        ]
      },
      {
        "category": "隔离开关",
        "prefix_any": [
          "IS-",
          "DS-",
          "HR",
          "NH40",
          "GL-",
          "GL",
          "HD",
          "HS"
        ],
        "contains_any": [
          "隔离开关",
          "隔离"
        ]
      },
      {
        "category": "塑壳断路器",
        "prefix_any": [
          "MCCB",
          "NM1",
          "NM8",
          "NXM",
          "NM",
          "NSX",
          "NS",
          "CVS",
          "EZD",
          "TMAX",
          "XT",
          "3VA",
          "3VM",
          "CDM",
          "NDM",
          "CM1",
          "CM3",
          "CM5"
        ],
        "contains_any": [
          "塑壳"
        ]
      },
      {
        "category": "微型断路器",
        "prefix_any": [
          "MCB",
          "DZ47",
          "IC65",
          "C65",
          "EA9",
          "EASY9",
          "ACTI9",
          "NXB",
          "NB1",
          "NDB",
          "CDB6",
          "CDB",
          "S200",
          "5SY",
          "5SL"
        ]
      }
    ],
    "curve_regex": "^[CDB](\\d{1,3})A?(?:/[1-4]P|\\b)",
    "curve_amp_split": 125,
    "curve_le_category": "微型断路器",
    "curve_gt_category": "塑壳断路器",
    "other_category": "断路器（其他）"
  },
  "vocabulary": {
    "circuit_no_regex": "^(?:(?:[A-Z0-9]+[-_])+(?:WL|WP|WX|WD|WS|WY|W|P|N|E|C|QF)\\d+[A-Z]?|(?:(?:B?\\d+|\\-\\d+)[-_]?)?(?:WL|WP|WX|WD|WS|WY|WE|W|P|N|E|QF)\\d+(?:[-_]\\d+|[A-Z])?|(?:PY|BF|XF|FS|FP|XP|ZL)[-_][A-Z0-9]+(?:[-_][A-Z0-9]+)*)$",
    "phase_regex": "^(L[123NPE~,\\.\\-\\s/]+|380/220V|220V|380V)$",
    "power_regex": "^(\\d+(\\.\\d+)?\\s*kW(\\s*x\\s*\\d+)?|Pe\\s*=\\s*\\d+(\\.\\d+)?\\s*kW)$",
    "current_regex": "^(\\d+(\\.\\d+)?\\s*A|\\d+~\\d+A)$",
    "cable_regex": "^(ZR|NH|WDZ|WDZN|ZA|ZB|ZC)?[\\-\\s]*(YJV|BV|BVR|RVV|KVV|BBTRZ)[\\-\\s\\d/]+.*",
    "engineering_unit_regex": "^\\d+(?:\\.\\d+)?(?:A|kA|kW|W|V|kV|Hz|kVA|VA|mm|m|min|h|s|lx|lm|kN|MPa|dB)$",
    "national_atlas_regex": "^\\d{2}[A-Z]{1,2}\\d{3}(-\\d+)?$",
    "circuit_no_max_digits": 4,
    "non_panel_token_regexes": [
      "^\\d{2,4}\\s*/\\s*\\d{2,4}\\s*V?$",
      "^[AD]?C?\\d{1,4}\\s*V$",
      "^\\d{1,4}\\s*(?:HZ|H)$",
      "^\\d+(?:\\.\\d+)?\\s*K?W$",
      "^\\d+\\s*(?:KA|MA)$",
      "^\\d{1,2}\\s*[X×]\\s*\\d+(?:\\.\\d+)?\\s*(?:A|MM2?)?$"
    ],
    "non_panel_token_comment": "电压/频率/功率这类工程量的写法，单独成文时不是箱号。若某项目确有形如 B1 的短箱号被误判，请在此按项目补正则（不要直接改代码）。"
  },
