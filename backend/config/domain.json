  "cable": {
    "_comment": "电缆型号系列与敷设方式的词法。新增线缆系列只改这里。",
    "family_patterns": [
      "\\b((?:WDZ[A-Z]*|ZR[A-Z]*|NH[A-Z]*|FS)?-?BYJ[A-Z]*)(?=[-_\\s\\d*(×x]|$)",
      "\\b((?:WDZ[A-Z]*|ZR[A-Z]*|NH[A-Z]*|FS)?-?(?:YJV|YJY)(?:22|23|32)?)(?=[-_\\s\\d*(×x]|$)",
      "\\b((?:WDZ[A-Z]*|ZR[A-Z]*|NH[A-Z]*|FS)?-?VV(?:22|23|32)?)(?=[-_\\s\\d*(×x]|$)",
      "\\b((?:WDZ[A-Z]*|ZR[A-Z]*|NH[A-Z]*|FS)?-?BVR)(?=[-_\\s\\d*(×x]|$)",
      "\\b((?:WDZ[A-Z]*|ZR[A-Z]*|NH[A-Z]*|FS)?-?BV)(?=[-_\\s\\d*(×x]|$)",
      "\\b((?:WDZ[A-Z]*|ZR[A-Z]*|NH[A-Z]*|FS)?-?RVVP?)(?=[-_\\s\\d*(×x]|$)"
    ],
    "laying_method_regex": "(?:-|/|\\s|^)((?:SC|PC|KBG|JDG|CT|MR|PR|CP|RC|PVC)\\d{0,3}(?:[/-](?:CC|WC|FC|WS|CE|ACC|SR|MR|CT|WE))*)\\b",
    "default_laying": "未标注"
  },
